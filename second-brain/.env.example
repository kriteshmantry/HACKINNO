# Copy to .env (same folder) and fill in ONE key. .env is gitignored, so keys never reach GitHub.
# The backend uses whichever key is set (Anthropic, then Gemini, then Groq), or SB_LLM_PROVIDER.

# Free: Google AI Studio (https://aistudio.google.com/apikey), sign in with a Google account
GEMINI_API_KEY=
# Free: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Paid: Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides
# SB_LLM_PROVIDER=gemini        # anthropic | gemini | groq | ollama
# SB_LLM_MODEL=gemini-flash-latest
