# Which backend the UI talks to.
#   auto  -> the FastAPI backend when /api answers, otherwise the built-in simulator (default)
#   http  -> always the FastAPI backend
#   mock  -> always the in-browser simulator (offline demos)
VITE_BACKEND=auto

# Where the dev server proxies /api to
VITE_API_TARGET=http://localhost:8000

# You can also switch at runtime with ?backend=http, ?backend=mock or ?backend=auto in the URL.
